# ==============================================================================
# Lumixora Notes AI — Enterprise Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3001

# Cross-Origin Resource Sharing (CORS)
# Set to specific production domain, or comma-separated list: https://notes.lumixora.com,https://app.lumixora.com
CORS_ORIGIN=*

# Frontend API Base URL (Used by Vite in production builds)
VITE_API_BASE_URL=http://localhost:3001

# AI Model Provider Credentials (Optional — Lumixora Academic Engine runs offline with zero keys)
# Google Gemini API: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API: https://platform.openai.com/
OPENAI_API_KEY=

# Cloud Storage Persistence (Optional: local / supabase / firebase)
VITE_STORAGE_PROVIDER=local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
